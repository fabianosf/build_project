DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Local Vite only by default. Production: set explicit origins; keep CORS_ALLOW_ALL_ORIGINS false.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRAGMENTOS_DIR=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Exemplo Groq (OpenAI-compatible):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT=60
LLM_MAX_PROMPT_CHARS=120000
# Fragment body sent to the LLM (Groq free tier ~8k TPM → keep low)
LLM_MAX_FRAGMENT_CHARS=8000
RAG_ENABLED=true
RAG_TOP_K=6
RAG_CHUNK_CHARS=1000
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SEC=5
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_CHARS=6000
# Opcional: Brave Search (melhor que DuckDuckGo HTML)
# BRAVE_SEARCH_API_KEY=
# Pasta do projeto no servidor (ler no chat + aplicar diffs)
# WORKSPACE_ROOT=/home/voce/meu-projeto
WORKSPACE_MAX_FILE_BYTES=200000
WORKSPACE_MAX_CONTEXT_CHARS=24000
WORKSPACE_SEARCH_TOP_K=8
WORKSPACE_RUN_TIMEOUT_SEC=60
MAX_REQUEST_CHARS=20000
MAX_DRAFT_CHARS=100000

# Frontend optional (leave empty to use Vite proxy)
# VITE_API_URL=http://127.0.0.1:8000
# NEVER put LLM_API_KEY in the frontend.
