DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Local Vite only by default. Production: set explicit origins; keep CORS_ALLOW_ALL_ORIGINS false.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRAGMENTOS_DIR=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Qualquer provedor OpenAI-compatible (trocar = só reiniciar o backend).
# Exemplo OpenAI / ChatGPT API (plano pago ou créditos) — qualidade/cota melhores;
# NÃO reduz tokens sozinho (tokens = tamanho do prompt+resposta). Preferir gpt-4o-mini.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# Exemplo DeepSeek (OpenAI-compatible; créditos na conta DeepSeek):
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-v4-flash
# (alternativa mais forte: deepseek-v4-pro; legado deepseek-chat foi retirado)
# Exemplo Groq (free/dev: Llama 3.3 70B foi retirado — use gpt-oss-120b):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=openai/gpt-oss-120b
# (não use llama-3.3-70b-versatile — HTTP 404 no free)
# Se 429 / saldo baixo, baixe os caps abaixo.
LLM_TIMEOUT=60
LLM_MAX_PROMPT_CHARS=120000
# Mais texto do .md no prompt (sobe tokens/TPM). 16000→32000 se a cota aguentar.
LLM_MAX_FRAGMENT_CHARS=32000
RAG_ENABLED=true
RAG_TOP_K=6
RAG_CHUNK_CHARS=1000
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SEC=5
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_CHARS=6000
# Opcional: Brave Search (melhor que DuckDuckGo HTML)
# BRAVE_SEARCH_API_KEY=
# Pasta do projeto no servidor (ler no chat + aplicar diffs)
# WORKSPACE_ROOT=/home/voce/meu-projeto
WORKSPACE_MAX_FILE_BYTES=200000
WORKSPACE_MAX_CONTEXT_CHARS=48000
WORKSPACE_SEARCH_TOP_K=8
WORKSPACE_RUN_TIMEOUT_SEC=60
# Limites por tarefa (antes de cada chamada à LLM). Sem compactação automática.
AGENT_MAX_ROUNDS=5
TASK_MAX_PROMPT_TOKENS_APPROX=100000
TASK_MAX_COMPLETION_TOKENS_APPROX=32000
MAX_REQUEST_CHARS=20000
MAX_DRAFT_CHARS=100000

# Frontend optional (leave empty to use Vite proxy)
# VITE_API_URL=http://127.0.0.1:8000
# NEVER put LLM_API_KEY in the frontend.
